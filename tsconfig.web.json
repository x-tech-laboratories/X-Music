{
  "extends": "./tsconfig.base.json",
  "include": ["src/renderer/**/*", "src/preload/*.d.ts", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "paths": { "@renderer/*": ["./src/renderer/*"], "@shared/*": ["./src/shared/*"] }
  }
}
