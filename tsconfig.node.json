{
  "extends": "./tsconfig.base.json",
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/workers/**/*", "scripts/**/*"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024"],
    "types": ["node", "electron-vite/node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  }
}
