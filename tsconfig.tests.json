{
  "extends": "./tsconfig.base.json",
  "include": ["tests/**/*", "bench/**/*", "vitest.config.ts", "src/main/**/*", "src/shared/**/*", "src/web/**/*", "src/preload/*.d.ts", "scripts/**/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": { "@main/*": ["./src/main/*"], "@shared/*": ["./src/shared/*"] }
  }
}
