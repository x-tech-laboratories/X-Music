{
  "name": "x-music",
  "version": "0.1.0",
  "description": "A customizable music player with a real library engine",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo 'electron-rebuild skipped; run npm run rebuild:electron before npm run dev'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "check": "npm run typecheck && npm run test",
    "app": "bash scripts/run.sh",
    "lint": "oxlint"
  },
  "dependencies": {
    "@x-tech-laboratories/halon": "^0.3.0",
    "@x-tech-laboratories/x-libs": "^0.8.0",
    "better-sqlite3": "^13.0.3",
    "music-metadata": "^11.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^43.0.0",
    "electron-vite": "^6.0.0",
    "fast-check": "^3.23.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
