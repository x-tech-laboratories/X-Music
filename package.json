{
  "name": "x-music",
  "version": "0.1.2",
  "description": "A customizable music player with a real library engine",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:desktop",
    "build:desktop": "tsc -b && electron-vite build",
    "start:desktop": "electron-vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "check": "npm run typecheck && npm run test",
    "app": "bash scripts/run.sh",
    "lint": "oxlint",
    "icons": "x-libs-icons",
    "db:generate": "drizzle-kit generate --config src/shared/library/drizzle.config.ts && x-libs-bundle-migrations src/shared/library/migrations"
  },
  "dependencies": {
    "@x-tech-laboratories/halon": "^0.25.1",
    "@x-tech-laboratories/x-libs": "^0.58.0",
    "music-metadata": "^11.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "1.0.0-rc.5",
    "electron": "^43.0.0",
    "electron-vite": "^6.0.0",
    "fast-check": "^3.23.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
